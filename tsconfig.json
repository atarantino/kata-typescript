{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "outDir": "dist",
        "strict": true,
        "noImplicitReturns": true,
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "baseUrl": "src",
        "paths": {
            "@code/*": [
                "day2/*"
            ]
        },
        "types": [
            "node",
            "vitest/globals"
        ]
    },
    "include": [
        "src/**/*.ts",
        "scripts/**/*.ts",
        "ligma.config.ts",
        "vitest.config.ts"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "src/__tests__/BFSGraphList.ts",
        "src/__tests__/DijkstraList.ts",
        "src/__tests__/InsertionSort.ts",
        "src/__tests__/ListTest.ts",
        "src/__tests__/MergeSort.ts",
        "src/__tests__/PrimsList.ts",
        "src/__tests__/RingBuffer.ts",
        "src/__tests__/graph.ts",
        "src/__tests__/tree.ts"
    ]
}
